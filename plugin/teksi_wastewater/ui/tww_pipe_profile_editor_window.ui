    <string>Fit</string>
   </property>
  </action>

  <action name="actionZoom100">
   <property name="text">
    <string>1:1</string>
   </property>
  </action>

  <action name="actionShowGrid">
   <property name="text">
    <string>Show Grid</string>
   </property>
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="checked">
    <bool>true</bool>
