      <constraintExpressions>
        <constraint desc="" exp="" field="obj_id"></constraint>
        <constraint desc="" exp="" field="direct_discharge_current"></constraint>
        <constraint desc="" exp="" field="direct_discharge_planned"></constraint>
        <constraint desc="between 0 and 100, and the sum ww+rw should be &lt;= 100 " exp="case&#xD;&#xA;when &quot;discharge_coefficient_rw_current&quot; is NULL then true&#xD;&#xA;when  &quot;discharge_coefficient_ww_current&quot; is NULL then  (&quot;discharge_coefficient_rw_current&quot; >=0 and  &quot;discharge_coefficient_rw_current&quot; &lt;=100) &#xD;&#xA;else (&quot;discharge_coefficient_rw_current&quot; + &quot;discharge_coefficient_ww_current&quot; &lt;=100)&#xD;&#xA;end " field="discharge_coefficient_rw_current"></constraint>
        <constraint desc="between 0 and 100, and the sum ww+rw should be &lt;= 100 " exp="case&#xD;&#xA;when &quot;discharge_coefficient_rw_planned&quot; is NULL then true&#xD;&#xA;when  &quot;discharge_coefficient_ww_planned&quot; is NULL then  (&quot;discharge_coefficient_rw_planned&quot; >=0 and  &quot;discharge_coefficient_rw_planned&quot; &lt;=100) &#xD;&#xA;else (&quot;discharge_coefficient_rw_planned&quot; + &quot;discharge_coefficient_ww_planned&quot; &lt;=100)&#xD;&#xA;end " field="discharge_coefficient_rw_planned"></constraint>
        <constraint desc="between 0 and 100" exp=" (&quot;discharge_coefficient_ww_current&quot; >=0 and  &quot;discharge_coefficient_ww_current&quot; &lt;=100) or  &quot;discharge_coefficient_ww_current&quot; is NULL" field="discharge_coefficient_ww_current"></constraint>
        <constraint desc="between 0 and 100" exp=" ( &quot;discharge_coefficient_ww_planned&quot;  >=0 and  &quot;discharge_coefficient_ww_planned&quot; &lt;=100) or  &quot;discharge_coefficient_ww_planned&quot; is NULL" field="discharge_coefficient_ww_planned"></constraint>
        <constraint desc="" exp="" field="drainage_system_current"></constraint>
        <constraint desc="" exp="" field="drainage_system_planned"></constraint>
        <constraint desc="" exp="" field="fk_dataowner"></constraint>
        <constraint desc="" exp="" field="fk_provider"></constraint>
