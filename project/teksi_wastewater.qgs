              <rule key="{541d3f6b-d7fe-414d-9ba3-f2068892d139}" label="BAO/BAP - visible soil">
                <rule filter="&quot;channel_damage_code&quot; = 4002" key="{14464c4e-1002-431a-b774-af20cc0d9c37}" label="visible soil" symbol="56"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 4003" key="{94eb7a7c-4e59-4bdb-ab2c-c048eb93d25e}" label="visible void" symbol="57"></rule>
