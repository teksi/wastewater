          <rule checkstate="0" description="renovation_necessity only if urgency_figure is NULL" filter="&quot;ws_status&quot; not in (3633,6523,6524, 6526 , 6529 ,6532, 7959 )" key="{35fbf1f7-8854-474d-bbd7-ac1034ae57d4}" label="urgency_figure or renovation_necessity">
            <rule filter=" &quot;ws_urgency_figure&quot; &lt; 50 or  ( &quot;ws_urgency_figure&quot; is NULL and &quot;ws_renovation_necessity&quot; = 5370  )" key="{a7beb584-3c16-4569-bf39-7392f815af53}" label="immediately - urgent" symbol="5"></rule>
            <rule filter="( &quot;ws_urgency_figure&quot; &lt; 150 and &quot;ws_urgency_figure&quot; >= 50 ) or  ( &quot;ws_urgency_figure&quot; is NULL and&quot;ws_renovation_necessity&quot; = 2  )" key="{ee23134d-baca-42f0-9b26-5414e016fbc9}" label="short_therm" symbol="6"></rule>
            <rule filter="( &quot;ws_urgency_figure&quot; &lt; 250 and &quot;ws_urgency_figure&quot; >= 150 ) or  ( &quot;ws_urgency_figure&quot; is NULL and&quot;ws_renovation_necessity&quot; = 3  )" key="{eec67f10-beb8-4b08-baff-e6b3712fca06}" label="medium_therm" symbol="7"></rule>
            <rule filter="( &quot;ws_urgency_figure&quot; &lt; 350 and &quot;ws_urgency_figure&quot; >=250 ) or  ( &quot;ws_urgency_figure&quot; is NULL and&quot;ws_renovation_necessity&quot; = 9295  )" key="{d676805c-93d3-4542-b791-4c80b7068054}" label="long_therm" symbol="8"></rule>
            <rule filter="(  &quot;ws_urgency_figure&quot; >= 350 ) or  ( &quot;ws_urgency_figure&quot; is NULL and&quot;ws_renovation_necessity&quot; =  5368   )" key="{d6ca6221-0519-470a-b695-165cc5402164}" label="none" symbol="9"></rule>
            <rule filter="&quot;ws_urgency_figure&quot; is NULL and  &quot;ws_renovation_necessity&quot;  =  5369  or&quot;ws_renovation_necessity&quot; is NULL " key="{ae1654f2-0f9f-456a-b706-7f437d91b820}" label="unknown" symbol="10"></rule>
          </rule>
          <rule checkstate="0" description="structure condition only if condition score is NULL" filter="&quot;ws_status&quot; not in (3633,6523,6524, 6526 , 6529 ,6532, 7959 )" key="{301b56fc-881c-4f8d-96fd-939cb4e21209}" label="condition_score or structure_condition">
            <rule filter="  &quot;ws_condition_score&quot;  &lt; 0.5  or  (&quot;ws_condition_score&quot; is NULL and  &quot;ws_structure_condition&quot;  =  3363  )" key="{8b721c2e-4fca-4ac2-b0a0-42ee8cae9cd4}" label="to 0.49 - Z0" symbol="11"></rule>
            <rule filter=" ( &quot;ws_condition_score&quot;  &lt; 1.5 and &quot;ws_condition_score&quot;  >= 0.5) or  (&quot;ws_condition_score&quot;  is NULL and &quot;ws_structure_condition&quot;  =  3359)   " key="{c7010f00-a005-45b1-958b-4980dd502f12}" label="0.5 to 1.49 - Z1 " symbol="12"></rule>
            <rule filter="(  &quot;ws_condition_score&quot;  &lt; 2.50 and  &quot;ws_condition_score&quot;  >= 1.50 ) or  (  &quot;ws_condition_score&quot;  is NULL and &quot;ws_structure_condition&quot;  = 3360  )" key="{df9d3156-d6fa-4856-a87a-f29f584055d3}" label="1.5 to 2.49 - Z2" symbol="13"></rule>
            <rule filter="( &quot;ws_condition_score&quot; &lt; 3.50 and  &quot;ws_condition_score&quot;  >=2.50 ) or  (  &quot;ws_condition_score&quot;  is NULL and &quot;ws_structure_condition&quot;  =  3361   ) " key="{daf133b4-edd8-4f2b-8336-0f599ac11c89}" label="2.5 to 3.49 - Z3" symbol="14"></rule>
            <rule filter="(   &quot;ws_condition_score&quot;  >= 3.50 ) or  (  &quot;ws_condition_score&quot;  is NULL and &quot;ws_structure_condition&quot;  =  3362   )" key="{da2a08b1-edb3-4109-8d54-ca4f9aa0bd23}" label="3.5 to 4.0 - Z4" symbol="15"></rule>
            <rule filter=" &quot;ws_condition_score&quot; is NULL and (&quot;ws_structure_condition&quot;  is NULL or  &quot;ws_structure_condition&quot; = 3037 )" key="{856f16eb-d8b1-44c6-b483-315fc5fe0431}" label="unknown" symbol="16"></rule>
          </rule>
          <rule filter=" &quot;ws_status&quot; in ( 3633 , 6523 , 6524 , 6526 , 6529,  6532 , 7959 )" key="{41296ba6-d61f-44a0-aa43-cedf8876e2e7}" label="not operative or planned" symbol="17"></rule>
