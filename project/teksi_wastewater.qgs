            <constraintExpressions>
              <constraint desc="" exp="" field="identifier"></constraint>
              <constraint desc="Please choose a wastewater structure type" exp="&quot;ws_type&quot; IS NOT NULL" field="ws_type"></constraint>
              <constraint desc="" exp="" field="ma_function"></constraint>
              <constraint desc="" exp="" field="ss_function"></constraint>
              <constraint desc="" exp="" field="fk_owner"></constraint>
              <constraint desc="" exp="" field="status"></constraint>
              <constraint desc="" exp="" field="obj_id"></constraint>
              <constraint desc="" exp="" field="_depth"></constraint>
              <constraint desc="" exp="" field="accessibility"></constraint>
              <constraint desc="Between 0 and 4.00" exp=" &quot;condition_score&quot; &lt;=4 and  &quot;condition_score&quot; >= 0 or  &quot;condition_score&quot; is NULL" field="condition_score"></constraint>
              <constraint desc="" exp="" field="contract_section"></constraint>
              <constraint desc="" exp="" field="elevation_determination"></constraint>
              <constraint desc="" exp="" field="financing"></constraint>
              <constraint desc="" exp="" field="fk_dataowner"></constraint>
              <constraint desc="" exp="" field="fk_operator"></constraint>
              <constraint desc="" exp="" field="fk_provider"></constraint>
              <constraint desc="" exp=" (    &quot;gross_costs&quot;    &lt;= 99999999.99 and  &quot;gross_costs&quot; >= 0) or ( &quot;gross_costs&quot;  is NULL)" field="gross_costs"></constraint>
              <constraint desc="between 20 and 0" exp=" (  &quot;inspection_interval&quot;  &lt;= 20 and  &quot;inspection_interval&quot; >= 0) or ( &quot;inspection_interval&quot;  is NULL)" field="inspection_interval"></constraint>
              <constraint desc="" exp="" field="last_modification"></constraint>
              <constraint desc="max length = 50" exp="case when  &quot;location_name&quot; is NULL then true&#xD;&#xA;else&#xD;&#xA;&#x9;length(&quot;location_name&quot;)&lt; 51&#xD;&#xA;end" field="location_name"></constraint>
              <constraint desc="" exp="" field="records"></constraint>
              <constraint desc="max length = 80" exp="case when    &quot;remark&quot;   is NULL then true&#xD;&#xA;else&#xD;&#xA;&#x9;length(  &quot;remark&quot;  )&lt; 81&#xD;&#xA;end" field="remark"></constraint>
              <constraint desc="" exp="" field="renovation_necessity"></constraint>
              <constraint desc="" exp=" (   &quot;replacement_value&quot;   &lt;= 9999999.99 and  &quot;replacement_value&quot; >= 0) or ( &quot;replacement_value&quot;  is NULL)" field="replacement_value"></constraint>
              <constraint desc="" exp="" field="rv_base_year"></constraint>
              <constraint desc="" exp="" field="rv_construction_type"></constraint>
              <constraint desc="" exp="" field="status_survey_year"></constraint>
              <constraint desc="" exp="" field="structure_condition"></constraint>
              <constraint desc="" exp="" field="subsidies"></constraint>
              <constraint desc="between 400 and 0" exp=" &quot;urgency_figure&quot; &lt;= 400 and  &quot;urgency_figure&quot; >=0 or  &quot;urgency_figure&quot; is NULL" field="urgency_figure"></constraint>
              <constraint desc="between 1800 and 2100" exp="( &quot;year_of_construction&quot; >= 1800 and  &quot;year_of_construction&quot; &lt; 2100) or ( &quot;year_of_construction&quot; is NULL)" field="year_of_construction"></constraint>
              <constraint desc="" exp="" field="year_of_replacement"></constraint>
              <constraint desc="" exp="" field="co_identifier"></constraint>
              <constraint desc="max length = 80" exp="case when    &quot;co_remark&quot;   is NULL then true&#xD;&#xA;else&#xD;&#xA;&#x9;length(  &quot;co_remark&quot;  )&lt; 81&#xD;&#xA;end" field="co_remark"></constraint>
              <constraint desc="" exp="" field="co_renovation_demand"></constraint>
              <constraint desc="" exp="" field="co_obj_id"></constraint>
              <constraint desc="" exp="" field="co_brand"></constraint>
              <constraint desc="" exp="" field="co_shape"></constraint>
              <constraint desc="between 4000 and 0" exp="( &quot;co_diameter&quot; >= 0 and &quot;co_diameter&quot;  &lt;= 4000) or ( &quot;co_diameter&quot;  is NULL)" field="co_diameter"></constraint>
              <constraint desc="" exp="" field="co_fastening"></constraint>
              <constraint desc="Between 5000 and -200" exp=" (&quot;co_level&quot; &lt;=5000 and  &quot;co_level&quot; >=-200) or  &quot;co_level&quot; is NULL" field="co_level"></constraint>
              <constraint desc="" exp="" field="co_material"></constraint>
              <constraint desc="" exp="" field="co_positional_accuracy"></constraint>
              <constraint desc="" exp="" field="co_sludge_bucket"></constraint>
              <constraint desc="" exp="" field="co_venting"></constraint>
              <constraint desc="" exp="" field="ma_orientation"></constraint>
              <constraint desc="" exp="" field="ma_amphibian_exit"></constraint>
              <constraint desc=" between 0 and 4000 mm" exp=" (&quot;ma_dimension1&quot; &lt;= 4000 and  &quot;ma_dimension1&quot; >= 0) or ( &quot;ma_dimension1&quot;  is  NULL)" field="ma_dimension1"></constraint>
              <constraint desc=" between 0 and dimension1  mm" exp=" (&quot;ma_dimension2&quot; &lt;=  &quot;ma_dimension1&quot;  and  &quot;ma_dimension2&quot; >= 0) or ( &quot;ma_dimension2&quot; is null)" field="ma_dimension2"></constraint>
              <constraint desc="" exp="" field="ma_material"></constraint>
              <constraint desc="" exp="" field="ma_possibility_intervention"></constraint>
              <constraint desc="" exp="" field="ma_surface_inflow"></constraint>
              <constraint desc="" exp="" field="ss_amphibian_exit"></constraint>
