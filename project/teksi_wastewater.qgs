                            <Option name="expression" type="QString" value="CASE&#xD;&#xA; WHEN  &quot;ws_status&quot; in (3633,6523,6524,6532) then project_color('twwc_status_inoperative')&#xD;&#xA; WHEN  &quot;ch_usage_current&quot; = 4526 THEN project_color('twwc_usage_wastewater') &#xD;&#xA; WHEN  &quot;ch_usage_current&quot; = 4522 THEN project_color('twwc_usage_combined_wastewater')&#xD;&#xA; WHEN  &quot;ch_usage_current&quot; = 9023 THEN project_color('twwc_usage_surface_water')&#xD;&#xA; WHEN  &quot;ch_usage_current&quot; = 4516 THEN project_color('twwc_usage_discharged_combined_wastewater')&#xD;&#xA; WHEN  &quot;ch_usage_current&quot; = 4514 THEN project_color('twwc_usage_clean_wastewater')&#xD;&#xA; WHEN  &quot;ch_usage_current&quot; = 4518 THEN project_color('twwc_usage_creek_water')&#xD;&#xA; WHEN  &quot;ch_usage_current&quot; = 4524 THEN project_color('twwc_usage_industrial_wastewater')&#xD;&#xA; WHEN  &quot;ch_usage_current&quot; = 5322 THEN project_color('twwc_usage_other')&#xD;&#xA; WHEN  &quot;ch_usage_current&quot; = 4571 THEN project_color('twwc_usage_unknown')&#xD;&#xA; ELSE project_color('twwc_usage_unknown')&#xD;&#xA; END"></Option>
