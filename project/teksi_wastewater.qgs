              <rule key="{c0776d0d-6d50-4f48-adf2-e2ea39c91084}" label="BAH - damaged connection">
                <rule filter="&quot;channel_damage_code&quot; = 3973" key="{34f60b39-b3cb-40d4-9383-025decb91850}" label="misaligned" symbol="40"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3974" key="{93e636f9-6306-4f53-a6f6-1bb7ba81d36d}" label="recessed" symbol="41"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3975" key="{af11d75a-f663-4f26-b12c-e6df24aeb598}" label="incompletely connected" symbol="42"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3976" key="{f04b944a-ac69-4538-b652-f4f87f69dcf0}" label="damaged" symbol="43"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3977" key="{b0825f59-07f3-434c-acce-1bff5ed6f86d}" label="blocked" symbol="44"></rule>
              </rule>
              <rule key="{8444b21a-6d69-49e7-b628-c9b49282d007}" label="BAI - protruding seal ring">
                <rule filter="&quot;channel_damage_code&quot; = 3979" key="{5de1b01a-faf2-4136-8719-44f8bf049e6c}" label="displaced" symbol="45"></rule>
                <rule filter="&quot;channel_damage_code&quot; >= 3980 AND &quot;channel_damage_code&quot; &lt;= 3981" key="{0e9ceb0b-301e-411a-b750-eec16be0f6a4}" label="not broken" symbol="46"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3982" key="{4b339928-a14b-4662-8a6d-7da3a7712826}" label="broken" symbol="47"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3983" key="{190cbd8b-9f91-402e-a217-2754185e78e1}" label="protruding seal material" symbol="48"></rule>
              </rule>
              <rule key="{25eb3d2b-9acc-488c-8d2e-33edbf16517f}" label="BAJ - displaced joint">
                <rule filter="&quot;channel_damage_code&quot; = 3984" key="{63cd098e-fbe1-47a3-99e8-15ac3b2ff0f7}" label="broad joint" symbol="49"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3985" key="{827fc599-6f90-496f-a2a8-366731cc2b20}" label="displaced" symbol="50"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3986" key="{3c3d9a89-406b-4697-978a-d604047ed68b}" label="kinked" symbol="51"></rule>
              </rule>
              <rule key="{d4d84b9b-0420-4527-8af1-7fd3d0f28fe9}" label="BAK- defect lining">
                <rule filter="&quot;channel_damage_code&quot; >= 3987 AND &quot;channel_damage_code&quot; &lt;= 3994" key="{8e07f957-68c7-4e66-8c59-89f6266c9f87}" label="defect lining" symbol="52"></rule>
              </rule>
              <rule key="{05146c31-d10b-4e25-bfe7-a9505c34d773}" label="BAL - defect repair">
                <rule filter="&quot;channel_damage_code&quot; >= 3995 AND &quot;channel_damage_code&quot; &lt;= 3997" key="{7f96b7a2-561a-4847-b567-8ea862390a9b}" label="defect repair" symbol="53"></rule>
              </rule>
              <rule key="{b5e8b7ab-1fbb-4f11-a39a-b1bd3e3d92bf}" label="BAM - defect welded joint">
                <rule filter="&quot;channel_damage_code&quot; >= 3998 AND &quot;channel_damage_code&quot; &lt;= 4000" key="{f477b80d-ab98-43e3-b4b6-d8a83e90963c}" label="defect welding" symbol="54"></rule>
              </rule>
              <rule key="{b0f067f9-c030-4edd-8ca0-3b5ebbadf10c}" label="BAN - porous pipe">
