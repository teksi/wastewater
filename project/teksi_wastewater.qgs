                  <rule filter="  &quot;ws_condition_score&quot;  &lt; 0.5  or  (&quot;ws_condition_score&quot; is NULL and  &quot;ws_structure_condition&quot;  =  3363  )" key="{8b721c2e-4fca-4ac2-b0a0-42ee8cae9cd4}" label="to 0.49 - Z0" symbol="11"></rule>
                  <rule filter=" ( &quot;ws_condition_score&quot;  &lt; 1.5 and &quot;ws_condition_score&quot;  >= 0.5) or  (&quot;ws_condition_score&quot;  is NULL and &quot;ws_structure_condition&quot;  =  3359)   " key="{c7010f00-a005-45b1-958b-4980dd502f12}" label="0.5 to 1.49 - Z1 " symbol="12"></rule>
                  <rule filter="(  &quot;ws_condition_score&quot;  &lt; 2.50 and  &quot;ws_condition_score&quot;  >= 1.50 ) or  (  &quot;ws_condition_score&quot;  is NULL and &quot;ws_structure_condition&quot;  = 3360  )" key="{df9d3156-d6fa-4856-a87a-f29f584055d3}" label="1.5 to 2.49 - Z2" symbol="13"></rule>
                  <rule filter="( &quot;ws_condition_score&quot; &lt; 3.50 and  &quot;ws_condition_score&quot;  >=2.50 ) or  (  &quot;ws_condition_score&quot;  is NULL and &quot;ws_structure_condition&quot;  =  3361   ) " key="{daf133b4-edd8-4f2b-8336-0f599ac11c89}" label="2.5 to 3.49 - Z3" symbol="14"></rule>
                  <rule filter="(   &quot;ws_condition_score&quot;  >= 3.50 ) or  (  &quot;ws_condition_score&quot;  is NULL and &quot;ws_structure_condition&quot;  =  3362   )" key="{da2a08b1-edb3-4109-8d54-ca4f9aa0bd23}" label="3.5 to 4.0 - Z4" symbol="15"></rule>
