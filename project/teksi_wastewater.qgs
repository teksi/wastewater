          <rule filter="(&quot;me_status&quot; in (2549 , 3047) or &quot;me_status&quot;  is NULL)  and  &quot;mn_kind&quot; in (9310,9311,9312,9313)" key="{6f32c814-5ff3-4258-a2a6-30e1bad8d7e9}" label="planned/unknown restorations">
