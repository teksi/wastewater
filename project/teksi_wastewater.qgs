        <constraint desc="" exp="" field="conformity"></constraint>
        <constraint desc="" exp="" field="continuance"></constraint>
        <constraint desc="" exp="" field="continuance_comment"></constraint>
        <constraint desc="between 0 and 100'000 m2" exp=" &quot;dung_heap_area_current&quot;     is NULL OR ( &quot;dung_heap_area_current&quot; >=0 AND  &quot;dung_heap_area_current&quot; &lt;=100000)" field="dung_heap_area_current"></constraint>
        <constraint desc="" exp="" field="dung_heap_area_nominal"></constraint>
        <constraint desc="" exp="" field="remark"></constraint>
        <constraint desc="" exp="" field="shepherds_hut_comment"></constraint>
        <constraint desc="between 0 and 300'000 EWG" exp=" &quot;shepherds_hut_population_equivalent&quot;      is NULL OR ( &quot;shepherds_hut_population_equivalent&quot; >=0 AND  &quot;shepherds_hut_population_equivalent&quot; &lt;=300000)" field="shepherds_hut_population_equivalent"></constraint>
        <constraint desc="" exp="" field="shepherds_hut_wastewater"></constraint>
        <constraint desc="" exp="" field="stable_cattle"></constraint>
        <constraint desc="between 0 and 300'000 DGVE" exp=" &quot;stable_cattle_equivalent_other_cattle&quot;       is NULL OR ( &quot;stable_cattle_equivalent_other_cattle&quot; >=0 AND  &quot;stable_cattle_equivalent_other_cattle&quot; &lt;=300000)" field="stable_cattle_equivalent_other_cattle"></constraint>
