              <constraint desc="" exp="" field="ss_emergency_overflow"></constraint>
              <constraint desc="" exp="" field="ss_possibility_intervention"></constraint>
              <constraint desc="" exp="" field="ss_stormwater_tank_arrangement"></constraint>
              <constraint desc="between 5000 and -200" exp="(  &quot;ss_upper_elevation&quot;  &lt;=5000 and  &quot;ss_upper_elevation&quot; >= -200) or  &quot;ss_upper_elevation&quot; is NULL" field="ss_upper_elevation"></constraint>
              <constraint desc="between 0 and 100000 l/s" exp=" (  &quot;ii_absorption_capacity&quot;   &lt;= 100000 and  &quot;ii_effective_area&quot; >= 0) or ( &quot;ii_effective_area&quot;  is NULL)" field="ii_absorption_capacity"></constraint>
              <constraint desc="" exp="" field="ii_defects"></constraint>
              <constraint desc="between 0 and 4000 mm" exp=" (&quot;ii_dimension1&quot; &lt;= 4000 and  &quot;ii_dimension1&quot; >= 0) or ( &quot;ii_dimension1&quot;  is NULL)" field="ii_dimension1"></constraint>
              <constraint desc="between 0 and dimension1  mm" exp=" (&quot;ii_dimension2&quot; &lt;=  &quot;ii_dimension1&quot;  and  &quot;ii_dimension2&quot; >= 0) or ( &quot;ii_dimension2&quot;  is NULL)" field="ii_dimension2"></constraint>
              <constraint desc="between 0 and 30000 m" exp=" &quot;ii_distance_to_aquifer&quot; >= 0 and  &quot;ii_distance_to_aquifer&quot; &lt;=30000 or  &quot;ii_distance_to_aquifer&quot; is NULL" field="ii_distance_to_aquifer"></constraint>
              <constraint desc="between 0 and 100000 m2" exp=" ( &quot;ii_effective_area&quot;  &lt;= 100000 and  &quot;ii_effective_area&quot; >= 0) or ( &quot;ii_effective_area&quot;  is NULL)" field="ii_effective_area"></constraint>
              <constraint desc="" exp="" field="ii_emergency_overflow"></constraint>
              <constraint desc="" exp="" field="ii_filling_material"></constraint>
              <constraint desc="" exp="" field="ii_fk_dss15_aquifer"></constraint>
              <constraint desc="" exp="" field="ii_kind"></constraint>
              <constraint desc="" exp="" field="ii_labeling"></constraint>
              <constraint desc="" exp="" field="ii_seepage_utilization"></constraint>
              <constraint desc="between -200 and 5000" exp="(  &quot;ii_upper_elevation&quot;     &lt;=5000 and  &quot;ii_upper_elevation&quot; >= -200) or  &quot;ii_upper_elevation&quot; is NULL" field="ii_upper_elevation"></constraint>
              <constraint desc="" exp="" field="ii_vehicle_access"></constraint>
              <constraint desc="" exp="" field="ii_watertightness"></constraint>
              <constraint desc="between -200 and 5000" exp="(   &quot;dp_highwater_level&quot;   &lt;=5000 and  &quot;dp_highwater_level&quot; >= -200) or  &quot;dp_highwater_level&quot; is NULL" field="dp_highwater_level"></constraint>
              <constraint desc="" exp="" field="dp_relevance"></constraint>
              <constraint desc="between -200 and 5000" exp="(  &quot;dp_terrain_level&quot;   &lt;=5000 and  &quot;dp_terrain_level&quot; >= -200) or  &quot;dp_terrain_level&quot; is NULL" field="dp_terrain_level"></constraint>
              <constraint desc="between -200 and 5000" exp="(  &quot;dp_upper_elevation&quot;     &lt;=5000 and  &quot;dp_upper_elevation&quot; >= -200) or  &quot;dp_upper_elevation&quot; is NULL" field="dp_upper_elevation"></constraint>
              <constraint desc="" exp="" field="dp_water_course_number"></constraint>
              <constraint desc="" exp="" field="dp_water_course_segment_canton"></constraint>
              <constraint desc="between -200 and 5000" exp="(   &quot;dp_waterlevel_hydraulic&quot;    &lt;=5000 and  &quot;dp_waterlevel_hydraulic&quot; >= -200) or  &quot;dp_waterlevel_hydraulic&quot; is NULL" field="dp_waterlevel_hydraulic"></constraint>
              <constraint desc="" exp="" field="wn_obj_id"></constraint>
              <constraint desc="between -200 and 5000" exp="( &quot;wn_backflow_level_current&quot; >=-200 and  &quot;wn_backflow_level_current&quot; &lt;= 5000 ) or ( &quot;wn_backflow_level_current&quot; is NULL)" field="wn_backflow_level_current"></constraint>
              <constraint desc="between -200 and 5000" exp=" &quot;wn_bottom_level&quot; >= -200 and  &quot;wn_bottom_level&quot; &lt;= 5000 or  &quot;wn_bottom_level&quot; is NULL" field="wn_bottom_level"></constraint>
              <constraint desc="" exp="" field="wn_elevation_accuracy"></constraint>
