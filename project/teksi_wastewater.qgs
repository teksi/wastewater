        <constraint desc="between -200 and 5000" exp=" &quot;wn_bottom_level&quot; >= -200 and  &quot;wn_bottom_level&quot; &lt;= 5000 or  &quot;wn_bottom_level&quot; is NULL" field="wn_bottom_level"></constraint>
