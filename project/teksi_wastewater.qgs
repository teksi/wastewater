        <rules key="{6736e613-3750-466f-8a9f-3310fefc92b3}">
          <rule key="{28efc329-670e-4128-b08a-d49480a1132f}" label="network plan">
            <rule filter="&quot;ws_type&quot; = 'manhole'   &#xD;&#xA;AND &#xD;&#xA; &quot;tww_is_primary&quot; &#xD;&#xA;AND&#xD;&#xA; &quot;ma_function&quot; in ( 228 , 4532 , 4533 , 4537 , 5344 , 5345 , 8654 , 8702 , 8703 , 8736 )" key="{563f75b3-dbfe-4684-b457-2feacfa60efc}" label="manhole - primary" symbol="0"></rule>
            <rule filter=" &quot;ws_type&quot;  =  'manhole' and (not &quot;tww_is_primary&quot; or  &quot;tww_is_primary&quot; is NULL)  and  &quot;ma_function&quot; not in (1008,8601,3267,5347,3266,2742,4536)" key="{46e86224-1894-4a73-86f5-67cecf692833}" label="manhole -not primary" symbol="1"></rule>
            <rule filter=" &quot;ma_function&quot; in ( 1008 , 8601 ) or  &quot;ss_function&quot; in ( 2768 , 8600 )" key="{73c00926-00b8-4ab2-9bf9-99cba0a59b09}" label="oil_separator, greace_separator" symbol="2"></rule>
            <rule filter=" &quot;ma_function&quot;  =  3267 " key="{95ecfcde-205e-480b-ba08-c1c111ac8ed2}" label="rain_water_manhole" symbol="3"></rule>
