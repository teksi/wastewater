              <constraint desc="between 0 and 99'999'999.99" exp="(  &quot;total_cost&quot;      &lt;100000000 and   &quot;total_cost&quot;  >= 0) or   &quot;total_cost&quot;  is NULL" field="total_cost"></constraint>
              <constraint desc="between 1800 and 2100, 1800 = unknown" exp="(     &quot;year_implementation_effective&quot;     &lt;=2100 and   &quot;year_implementation_effective&quot;  >= 1800) or   &quot;year_implementation_effective&quot;  is NULL" field="year_implementation_effective"></constraint>
              <constraint desc="between 1800 and 2100, 1800 = unknown" exp="(    &quot;year_implementation_planned&quot;     &lt;=2100 and   &quot;year_implementation_planned&quot;  >= 1800) or   &quot;year_implementation_planned&quot;  is NULL" field="year_implementation_planned"></constraint>
              <constraint desc="" exp="" field="last_modification"></constraint>
              <constraint desc="" exp="" field="fk_dataowner"></constraint>
              <constraint desc="" exp="" field="fk_provider"></constraint>
              <constraint desc="" exp="" field="fk_responsible_entity"></constraint>
              <constraint desc="" exp="" field="fk_responsible_start"></constraint>
            </constraintExpressions>
