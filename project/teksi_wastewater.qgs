          <rule description="double lines for large channel" key="{8df438f0-2f26-40b0-9377-192d9dfc2dff}" label="network plan">
            <rule description="dot if positioning not accurate, hashed if pump or vacuum, marker if drainage/infiltration" filter=" &quot;tww_is_primary&quot; " key="{1d87c48a-70cb-495b-9e3e-a2f776831965}" label="primary symbols no double lines" symbol="0"></rule>
