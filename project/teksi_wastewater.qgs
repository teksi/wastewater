              <rule checkstate="0" key="{9b480fd8-b389-49de-90da-6dac18c2285d}" label="BAF - surface damage">
                <rule filter="&quot;channel_damage_code&quot; >= 3922 AND &quot;channel_damage_code&quot; &lt;= 3926" key="{66932c75-7a33-4beb-9770-5653e63cd4ed}" label="rough pipe wall" symbol="30"></rule>
                <rule filter="&quot;channel_damage_code&quot; IN( 3927,  3928)" key="{c523b265-cb3d-4282-be20-8f1592529610}" label="spalling" symbol="31"></rule>
                <rule filter="&quot;channel_damage_code&quot; >= 3929 AND &quot;channel_damage_code&quot; &lt;= 3943" key="{5f838c18-1727-4370-b337-0e9eb177ca84}" label="exposed or missing aggregate" symbol="32"></rule>
                <rule filter="&quot;channel_damage_code&quot; >= 3944 AND &quot;channel_damage_code&quot; &lt;= 3948" key="{af0abd01-c617-4b37-8f14-b10b5bf1401f}" label="visible reinforcement" symbol="33"></rule>
                <rule filter="&quot;channel_damage_code&quot; >= 3949 AND &quot;channel_damage_code&quot; &lt;= 3953" key="{c6cdb0e2-5724-4045-9af2-de45dee9d489}" label="protruding reinforcement" symbol="34"></rule>
                <rule filter="&quot;channel_damage_code&quot; >= 3954 AND &quot;channel_damage_code&quot; &lt;= 3957" key="{5e674ac1-7e7a-47f0-a3eb-71665299899f}" label="corroded reinforcement" symbol="35"></rule>
                <rule filter="&quot;channel_damage_code&quot; >= 3958 AND &quot;channel_damage_code&quot; &lt;= 3962" key="{0b6f5caa-4daa-4310-a430-4a93069dc01b}" label="missing pipe wall" symbol="36"></rule>
                <rule filter="&quot;channel_damage_code&quot; >= 3963 AND &quot;channel_damage_code&quot; &lt;= 3966" key="{df689321-82bc-45d9-a43e-f879d1c95fba}" label="corroded pipe wall" symbol="37"></rule>
                <rule filter="&quot;channel_damage_code&quot; >= 3967 AND &quot;channel_damage_code&quot; &lt;= 3971" key="{307906f8-5564-4e06-877f-3b9957807d85}" label="other" symbol="38"></rule>
              </rule>
              <rule key="{45416f29-02bb-4792-92f5-f3bb87301ed2}" label="BAG - protruding connection">
                <rule filter="&quot;channel_damage_code&quot; = 3972" key="{cde0e949-d9da-4e25-ae02-8e9b7c51f533}" label="protruding connection" symbol="39"></rule>
