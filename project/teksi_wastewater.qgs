                  <rule filter="( &quot;ws_urgency_figure&quot; &lt; 150 and &quot;ws_urgency_figure&quot; >= 50 ) or  ( &quot;ws_urgency_figure&quot; is NULL and&quot;ws_renovation_necessity&quot; = 2  )" key="{ee23134d-baca-42f0-9b26-5414e016fbc9}" label="short_therm" symbol="6"></rule>
                  <rule filter="( &quot;ws_urgency_figure&quot; &lt; 250 and &quot;ws_urgency_figure&quot; >= 150 ) or  ( &quot;ws_urgency_figure&quot; is NULL and&quot;ws_renovation_necessity&quot; = 3  )" key="{eec67f10-beb8-4b08-baff-e6b3712fca06}" label="medium_therm" symbol="7"></rule>
                  <rule filter="( &quot;ws_urgency_figure&quot; &lt; 350 and &quot;ws_urgency_figure&quot; >=250 ) or  ( &quot;ws_urgency_figure&quot; is NULL and&quot;ws_renovation_necessity&quot; = 9295  )" key="{d676805c-93d3-4542-b791-4c80b7068054}" label="long_therm" symbol="8"></rule>
                  <rule filter="(  &quot;ws_urgency_figure&quot; >= 350 ) or  ( &quot;ws_urgency_figure&quot; is NULL and&quot;ws_renovation_necessity&quot; =  5368   )" key="{d6ca6221-0519-470a-b695-165cc5402164}" label="none" symbol="9"></rule>
                  <rule filter="&quot;ws_urgency_figure&quot; is NULL and  &quot;ws_renovation_necessity&quot;  =  5369  or&quot;ws_renovation_necessity&quot; is NULL " key="{ae1654f2-0f9f-456a-b706-7f437d91b820}" label="unknown" symbol="10"></rule>
