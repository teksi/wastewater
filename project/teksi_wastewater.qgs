                <rule key="{6e58716a-c1de-4050-8846-a9160287423f}" label="BBB- incrustations" symbol="60"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 4006" key="{fde806d2-6dd1-41c4-9d89-97b4d5a6c03c}" label="complex roots" symbol="61"></rule>
              </rule>
              <rule key="{b1553ff7-f157-42f5-8fb4-cdff93533152}" label="BBB- adhering material">
                <rule filter="&quot;channel_damage_code&quot; = 4007" key="{f7721b77-0002-451f-b932-6c43f4f22f49}" label="lime" symbol="62"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 4008" key="{d50ae1a4-1c73-4feb-a346-bb2bdb17a5d9}" label="fat" symbol="63"></rule>
