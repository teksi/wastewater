        <constraint desc="length(&quot;identifier&quot; )&lt;=20" exp="length(&quot;identifier&quot; )&lt;=20" field="identifier"></constraint>
        <constraint desc="" exp="" field="infiltration_current"></constraint>
        <constraint desc="" exp="" field="infiltration_planned"></constraint>
        <constraint desc="" exp="" field="last_modification"></constraint>
        <constraint desc="between 0 and 10'000" exp="( &quot;population_density_current&quot; >=0 and &quot;population_density_current&quot; &lt;=10000) or ( &quot;population_density_current&quot; is NULL)" field="population_density_current"></constraint>
        <constraint desc="between 0 and 10000" exp="( &quot;population_density_planned&quot; >=0 and &quot;population_density_planned&quot; &lt;=10000) or ( &quot;population_density_planned&quot; is NULL)" field="population_density_planned"></constraint>
        <constraint desc="" exp="" field="remark"></constraint>
        <constraint desc="" exp="" field="retention_current"></constraint>
        <constraint desc="" exp="" field="retention_planned"></constraint>
        <constraint desc="between 0 and 999.9" exp="(  &quot;runoff_limit_current&quot;>=0 and &quot;runoff_limit_current&quot; &lt;=100000) or ( &quot;runoff_limit_current&quot; is NULL)" field="runoff_limit_current"></constraint>
        <constraint desc="between 0 and 999.9" exp="(  &quot;runoff_limit_planned&quot;>=0 and &quot;runoff_limit_planned&quot; &lt;=100000) or ( &quot;runoff_limit_planned&quot; is NULL)" field="runoff_limit_planned"></constraint>
        <constraint desc="between 0 and 100, and the sum ww+rw should be &lt;= 100 " exp="((&quot;seal_factor_rw_current&quot; BETWEEN 0 and  100) OR &quot;seal_factor_rw_current&quot; IS NULL) and ( coalesce(&quot;seal_factor_rw_current&quot;,0) + coalesce(&quot;seal_factor_ww_current&quot;,0) &lt;=100)" field="seal_factor_rw_current"></constraint>
        <constraint desc="between 0 and 100, and the sum ww+rw should be &lt;= 100 " exp="((&quot;seal_factor_rw_planned&quot; BETWEEN 0 and  100) OR &quot;seal_factor_rw_planned&quot; IS NULL) and ( coalesce(&quot;seal_factor_rw_planned&quot;,0) + coalesce(&quot;seal_factor_ww_planned&quot;,0) &lt;=100)" field="seal_factor_rw_planned"></constraint>
        <constraint desc="between 0 and 100" exp=" (&quot;seal_factor_ww_current&quot;>=0 and  &quot;seal_factor_ww_current&quot; &lt;=100) or  &quot;seal_factor_ww_current&quot; is NULL" field="seal_factor_ww_current"></constraint>
        <constraint desc="between 0 and 100" exp=" (&quot;seal_factor_ww_planned&quot;>=0 and  &quot;seal_factor_ww_planned&quot; &lt;=100) or  &quot;seal_factor_ww_planned&quot; is NULL" field="seal_factor_ww_planned"></constraint>
        <constraint desc="between 0 and 100'000" exp="(  &quot;sewer_infiltration_water_production_current&quot;  >=0 and &quot;sewer_infiltration_water_production_current&quot; &lt;=100000) or ( &quot;sewer_infiltration_water_production_current&quot; is NULL)" field="sewer_infiltration_water_production_current"></constraint>
        <constraint desc="between 0 and 100'000" exp="(  &quot;sewer_infiltration_water_production_planned&quot;  >=0 and &quot;sewer_infiltration_water_production_planned&quot; &lt;=100000) or ( &quot;sewer_infiltration_water_production_planned&quot; is NULL)" field="sewer_infiltration_water_production_planned"></constraint>
        <constraint desc="" exp="" field="surface_area"></constraint>
        <constraint desc="between 0 and 100'000" exp="(  &quot;waste_water_production_current&quot;  >=0 and &quot;waste_water_production_current&quot; &lt;=100000) or ( &quot;waste_water_production_current&quot; is NULL)" field="waste_water_production_current"></constraint>
        <constraint desc="between 0 and 100'000" exp="(  &quot;waste_water_production_planned&quot;  >=0 and &quot;waste_water_production_planned&quot; &lt;=100000) or ( &quot;waste_water_production_planned&quot; is NULL)" field="waste_water_production_planned"></constraint>
