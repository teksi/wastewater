      <renderer-v2 enableorderby="0" forceraster="0" referencescale="-1" symbollevels="0" type="RuleRenderer">
        <rules key="{ca6365e7-1eaa-4801-938a-70dbe4f596fd}">
          <rule filter="&quot;channel_damage_code&quot; in( 4046,4048,4050,4052, 4054, 4058, 4060)" key="{0a782be8-fdfb-4e5c-a45f-3b069b2c531c}" label="Direction of Connection">
            <rule filter="(&quot;channel_damage_begin&quot; &lt;6 AND direction = 'f') OR (&quot;channel_damage_begin&quot; BETWEEN 6 AND 12 AND direction  != 'f')" key="{55536497-c8e0-4b3a-b8b3-3bebc90682e9}" label="left in direction of flow" symbol="0"></rule>
            <rule filter="(&quot;channel_damage_begin&quot; BETWEEN 6 AND 12 AND direction = 'f') OR (&quot;channel_damage_begin&quot; &lt; 6 AND direction  != 'f')" key="{bc51fed4-2e79-465f-83c7-200d620a627d}" label="right in direction of flow" symbol="1"></rule>
            <rule filter="&quot;channel_damage_begin&quot; = 12" key="{cc834934-0970-47da-aa8b-fc358d5aab73}" label="up" symbol="2"></rule>
          </rule>
          <rule checkstate="0" key="{6cf04f62-97fb-42c0-9baf-a95c91e74373}" label="Damage code">
            <rule key="{e0d362a5-1a29-4549-80bf-fb6561cc4b13}" label="AEC- change of profile">
              <rule filter="&quot;channel_damage_code&quot; = 4104" key="{d54f752b-2880-4a58-a596-0f85c87fb303}" label="egg" symbol="3"></rule>
              <rule filter="&quot;channel_damage_code&quot; = 4105" key="{8febf84b-8667-4aee-86f5-a5c5d3d56948}" label="circular" symbol="4"></rule>
              <rule filter="&quot;channel_damage_code&quot; = 4106" key="{d2853e58-e262-4482-b504-fb1ab0a31dde}" label="mouth" symbol="5"></rule>
              <rule filter="&quot;channel_damage_code&quot; = 4107" key="{d96c0ffa-2320-4567-977a-f9213fe8ef6d}" label="open" symbol="6"></rule>
              <rule filter="&quot;channel_damage_code&quot; = 4108" key="{e802a3a3-e52d-4a0a-97d8-00429697c270}" label="rectangular" symbol="7"></rule>
              <rule filter="&quot;channel_damage_code&quot; = 4109" key="{7814f9d3-de14-4c0c-aaa3-79580e3e1ae7}" label="special" symbol="8"></rule>
              <rule filter="&quot;channel_damage_code&quot; = 4110" key="{f5769617-9bba-4b21-ba85-c36e3d8856f7}" label="unknown" symbol="9"></rule>
            </rule>
            <rule key="{bb580013-5425-4701-8240-522136e266aa}" label="AED - change of material">
              <rule filter="&quot;channel_damage_code&quot; >= 4111 AND &quot;channel_damage_code&quot; &lt;= 4134" key="{6a3631b8-7891-4ccb-9bfa-e57a37a03a98}" label="change of material" symbol="10"></rule>
            </rule>
            <rule checkstate="0" key="{4c24402a-19e9-4c90-9a3f-4390743487c8}" label="BA - structural condition">
              <rule checkstate="0" key="{ede9c537-e605-4618-bd55-239aa0a0814f}" label="BAA - deformed pipe">
                <rule filter="&quot;channel_damage_code&quot; = 3900" key="{fed8c55c-af55-456f-9ae4-ba5fc5eb05eb}" label="vertically" symbol="11"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3901" key="{8e240262-7604-4e4d-915f-86d968465a6a}" label="horizontally" symbol="12"></rule>
              </rule>
              <rule checkstate="0" key="{4bef8f8e-2d45-4163-8b75-538fea1027d6}" label="BAB - cracks">
                <rule filter="&quot;channel_damage_code&quot; = 3902" key="{723231cd-2d95-4908-8dc7-e95d0a9c3ce5}" label="superficial, lengthwise" symbol="13"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3903" key="{cb167423-b841-4fa9-8654-2b6e9c13ab86}" label="superficial, radial" symbol="14"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3904" key="{ba0b9815-bb9c-405a-80f6-2957d905f643}" label="superficial, complex" symbol="15"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3905" key="{c82dc9f7-7a53-48c6-a428-8da204511f87}" label="superficial, spiral-shaped" symbol="16"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3906" key="{b4ee5a1f-ba4d-4175-9f9e-ef889431fa8f}" label="lengthwise" symbol="17"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3907" key="{9a087614-8805-401d-9e51-58e32bff6e37}" label="radial" symbol="18"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3908" key="{55254ccb-672e-4591-a93e-a5647c331ea2}" label="complex" symbol="19"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3909" key="{0fef29b2-8cbf-4184-835d-6bb6eb84d1c0}" label="spiral-shaped" symbol="20"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3910" key="{db59afab-2424-4c80-ac4d-81f5df478a07}" label="gaping, lengthwise" symbol="21"></rule>
                <rule filter="&quot;channel_damage_code&quot; = 3912" key="{7ef1cef3-2053-46d3-9e47-873deb96526b}" label="gaping, complex or spiral-shaped" symbol="22"></rule>
